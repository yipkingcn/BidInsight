# AI 模型 API 配置
# 用于项目内容 AI 分析功能

# API Key (必填)
# 从 Kimi 开放平台获取: https://platform.moonshot.cn/console/api-keys
OPENAI_API_KEY=your-kimi-api-key-here

# API Base URL (可选，默认使用 Kimi)
# Kimi (默认): https://api.moonshot.cn/v1
# OpenAI: https://api.openai.com/v1
OPENAI_BASE_URL=https://api.moonshot.cn/v1

# 模型选择 (在代码中配置，此处仅作说明)
# Kimi 模型:
#   - moonshot-v1-8k (默认，性价比高)
#   - moonshot-v1-32k (长文本)
#   - moonshot-v1-128k (超长文本)
# OpenAI 模型:
#   - gpt-4o-mini (便宜快速)
#   - gpt-4o (最强性能)

